# Copiar a .env y cambiar los valores:  cp .env.example .env
# Nunca versionar el archivo .env real.

# Puerto público de la aplicación (frontend + API gateway)
APP_PORT=8090

MARIADB_ROOT_PASSWORD=cambiar-root-password
USERS_DB_PASSWORD=cambiar-users-password
CATALOG_DB_PASSWORD=cambiar-catalog-password
ORDERS_DB_PASSWORD=cambiar-orders-password

# Mínimo 32 caracteres. Generar con:  openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=120

# Clave para la comunicación interna entre microservicios
INTERNAL_API_KEY=cambiar-clave-interna

# Intervalo con que el simulador de logística avanza el estado de las órdenes (ISO-8601)
ORDERS_STATUS_ADVANCE_INTERVAL=PT2M
